# REALM OS — optional environment overrides. Copy to .env (gitignored). NO secrets required.
# Per-user data directory (default: %LOCALAPPDATA%\REALM OS on Windows).
# REALMOS_DATA_DIR=C:\Users\<you>\REALM OS Data
# Force Qt platform. Leave UNSET for a normal window. Use "offscreen" ONLY for headless CI.
# QT_QPA_PLATFORM=windows
# QT_QPA_PLATFORM=offscreen
